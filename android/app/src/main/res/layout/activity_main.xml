<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="局域网测速"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="任意两台设备 · 1 MiB 数据块 · TCP 双缓冲"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="对方 IP（启动自动扫描，可手动修改）"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/peer_ip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:digits="0123456789."
                android:gravity="center_vertical"
                android:hint="192.168.1.2"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="15"
                android:selectAllOnFocus="false"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/panel"
                android:text="扫描"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/local_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="本机 --:5201    对方 --"
            android:textColor="@color/faint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/pipeline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="发送流水线线程（实验）"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/logging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:buttonTint="@color/accent"
            android:checked="false"
            android:text="记录诊断日志（logcat，默认关闭）"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="就绪"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0.00"
                android:textColor="@color/text"
                android:textSize="60sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingBottom="10dp"
                android:text="Mbps"
                android:textColor="@color/accent"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/speed_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="≈ 0.00 MB/s"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@color/panel"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/result_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text="手机 → 电脑    --"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/result_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="电脑 → 手机    --"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="两台设备启动后自动互相发现；各自点击一次“开始测速”。"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:text="开始测速"
                android:textAllCaps="false"
                android:textColor="#FF08161F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="停止"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="自动识别监听/连接端 · 端口 5201-5204 · 单方向 10 秒 · 日志默认关闭"
            android:textColor="@color/faint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
